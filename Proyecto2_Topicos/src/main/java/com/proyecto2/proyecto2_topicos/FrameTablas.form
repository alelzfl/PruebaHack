      <SubComponents>
        <Component class="javax.swing.JTextArea" name="jTextAreaExplicacion">
          <Properties>
            <Property name="editable" type="boolean" value="false"/>
            <Property name="columns" type="int" value="20"/>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="Segoe UI" size="14" style="0"/>
            </Property>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="El presente reporte tabular se genera a partir de la unificaci&#xf3;n (JOIN) de los &#xa;cat&#xe1;logos geogr&#xe1;ficos estatales y la tipolog&#xed;a de delitos con la tabla &#xa;transaccional de incidencias. Esto permite transformar identificadores &#xa;num&#xe9;ricos en informaci&#xf3;n legible, mostrando la relaci&#xf3;n directa entre un &#xa;estado, el tipo de crimen y la cantidad de casos ocurridos en un a&#xf1;o &#xa;espec&#xed;fico, facilitando as&#xed; el an&#xe1;lisis de la seguridad p&#xfa;blica.&#xa;&#xa;Fuentes:&#xa;SESNSP, Incidencia delictiva del fuero com&#xfa;n &#xa;SESNSP, Incidencia delictiva del fuero com&#xfa;n a nivel municipal&#xa;IMPLAN Torre&#xf3;n, Monitor de Seguridad&#xa;INEGI, Cat&#xe1;logo &#xda;nico de Claves de &#xc1;reas Geoestad&#xed;sticas"/>
            <Property name="wrapStyleWord" type="boolean" value="true"/>
          </Properties>
        </Component>
      </SubComponents>
    </Container>
